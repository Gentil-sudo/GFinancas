# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Supabase > botão "Connect" no topo do painel > aba .env.local
# (lá os nomes começam com NEXT_PUBLIC_; aqui usamos VITE_. A "publishable key" vai em VITE_SUPABASE_ANON_KEY)
#
# Use APENAS a chave pública "anon" (ou "publishable"). NUNCA coloque a service_role aqui.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui
