# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Supabase > botão "Connect" no topo do painel > Framework: React, Using: Vite > aba .env.local
#
# Use APENAS a chave pública "publishable" (sb_publishable_...).
# NUNCA coloque a chave "secret" / service_role aqui.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua-chave-aqui
